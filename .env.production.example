# ==============================================================================
# DF-EWDSS - Konfigurasi Lingkungan Produksi (Niagahoster)
# ==============================================================================

# Mode aplikasi
NODE_ENV=production

# Port aplikasi (cPanel Passenger otomatis mengelola ini jika tidak diatur)
PORT=4000

# Domain yang diizinkan mengakses API & WebSocket.
# Gunakan '*' untuk mengizinkan semua domain, atau sebutkan domain Anda:
# Contoh: CLIENT_ORIGIN=https://reoc.namadomain.com
CLIENT_ORIGIN=*

# Kunci rahasia untuk enkripsi token JWT sesi login.
# Ganti dengan teks acak yang panjang dan aman!
JWT_SECRET=reoc-pln-secret-jwt-key-production-change-this-string-9876543210

# API Key untuk integrasi ingest sensor dari lapangan (ESP32/PLC/Gateway)
SENSOR_API_KEY=reoc-sensor-production-api-key-secure-2026

# ==============================================================================
# Konfigurasi Database MySQL Niagahoster
# ==============================================================================
# Jika berjalan di cPanel / Server Niagahoster yang sama: DB_HOST=localhost
# Jika berjalan di Railway / Remote: isi dengan Host/IP server Niagahoster Anda
DB_HOST=
DB_PORT=3306
DB_USER=u389110718_power12
DB_PASSWORD=Poweradisucipto26.
DB_NAME=u389110718_power12
