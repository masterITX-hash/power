{
  "name": "df-ewdss",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "app.js",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,blue \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "build:client": "npm run build -w client",
    "start": "node app.js",
    "test": "npm run test -w server",
    "bundle": "node scripts/bundle.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "fflate": "^0.8.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.5",
    "pdfkit": "^0.16.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
